# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# CSV с размеченными транзакциями. Файл монтируется в data_loader и transaction_simulator.
TRAIN_DATA_CSV="/path/to/train.csv"

# Параметры окна обучения и поставки (свои значения, у семинара 3 мес / 100k / 3 года)
INITIAL_WINDOW_START=2019-01-01
WINDOW_MONTHS=4
SUPPLY_BATCH_SIZE=50000
HISTORY_YEARS=2
# Quality gate: публиковать, если PR-AUC кандидата >= PR-AUC прода - QUALITY_TOLERANCE
QUALITY_TOLERANCE=0.0
